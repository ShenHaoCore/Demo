{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OrderTimeout": {
    "Provider": "TimingWheel",
    "Redis": "localhost:6379",
    "RedisKey": "order:timeout",
    "PollIntervalMs": 500,
    "RabbitMq": "amqp://guest:guest@localhost:5672/",
    "DelayExchange": "order.timeout.delay",
    "DelayQueue": "order.timeout.delay",
    "DelayRoutingKey": "delay",
    "CloseExchange": "order.timeout.close",
    "CloseQueue": "order.timeout.close",
    "CloseRoutingKey": "close"
  }
}
